datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  users     User[]
  leads     Lead[]
  deals     Deal[]
  customers Customer[]
  tickets   Ticket[]
  tasks     Task[]
}

model User {
  id             String       @id @default(cuid())
  name           String
  email          String       @unique
  password       String
  role           Role         @default(SALES)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())
  assignedLeads  Lead[]
  assignedDeals  Deal[]
  assignedTickets Ticket[]
  tasks          Task[]
}

enum Role {
  ADMIN
  SALES
  SUPPORT
  AGENT
}

model Lead {
  id             String       @id @default(cuid())
  name           String
  email          String?
  phone          String?
  source         String?
  score          Int          @default(0)
  status         LeadStatus   @default(NEW)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  assignedToId   String?
  assignedTo     User?        @relation(fields: [assignedToId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

enum LeadStatus {
  NEW
  FOLLOW_UP
  QUALIFIED
  LOST
}

model Deal {
  id             String       @id @default(cuid())
  title          String
  value          Float
  stage          DealStage    @default(NEW)
  probability    Int          @default(50)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  assignedToId   String?
  assignedTo     User?        @relation(fields: [assignedToId], references: [id])
  customerId     String?
  customer       Customer?    @relation(fields: [customerId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

enum DealStage {
  NEW
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

model Customer {
  id             String       @id @default(cuid())
  name           String
  email          String?
  phone          String?
  company        String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  deals          Deal[]
  tickets        Ticket[]
  createdAt      DateTime     @default(now())
}

model Ticket {
  id             String       @id @default(cuid())
  subject        String
  description    String
  status         TicketStatus @default(OPEN)
  priority       Priority     @default(MEDIUM)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  customerId     String?
  customer       Customer?    @relation(fields: [customerId], references: [id])
  assignedToId   String?
  assignedTo     User?        @relation(fields: [assignedToId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING
  RESOLVED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Task {
  id             String       @id @default(cuid())
  title          String
  dueDate        DateTime?
  completed      Boolean      @default(false)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  assignedToId   String?
  assignedTo     User?        @relation(fields: [assignedToId], references: [id])
  createdAt      DateTime     @default(now())
}
