# MongoDB Connection (Mongoose)
MONGODB_URI="mongodb+srv://username:password@cluster.mongodb.net/nexacrm?retryWrites=true&w=majority"

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME="your_cloud_name"
