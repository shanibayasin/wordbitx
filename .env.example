# NextAuth Configuration
NEXTAUTH_SECRET="nexacrm_super_secret_jwt_key_at_least_32_characters_long"
NEXTAUTH_URL="http://localhost:3000"

# Gemini AI (Optional AI capabilities)
GEMINI_API_KEY="your_gemini_api_key_here"

# Application URL
APP_URL="http://localhost:3000"
